NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_UI_TELEMETRY_ENABLED=true
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:4000/telemetry

# Stellar network the app talks to. Drives explorer links and the network badge.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed Soroban contract addresses. The defaults baked into
# `lib/deployment.ts` are the live Testnet deployment recorded in
# `soroban/deployments/manifest.json`; override them to point at a local
# Soroban node or another deployment. These are public identifiers, not keys.
NEXT_PUBLIC_NFT_CONTRACT_ID=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ID=
NEXT_PUBLIC_COLLECTION_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_TRANSACTION_CONTRACT_ID=